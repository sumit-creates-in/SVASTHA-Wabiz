# ── Server ──────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/svastha-wabiz
# Secret for signing JWT login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
# First-run admin login (created automatically if no user exists)
ADMIN_EMAIL=lovish19@gmail.com
ADMIN_PASSWORD=change-me

# ── WhatsApp Cloud API (Meta) ───────────────────────────
# App-wide permanent token. Individual numbers can override this in the dashboard.
WHATSAPP_TOKEN=EAAG...your-permanent-system-user-token
# Optional: seeds your FIRST number on initial boot. Add the rest under Numbers in the UI.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
# Any string you choose; must match what you enter in Meta webhook config
WHATSAPP_VERIFY_TOKEN=svastha-verify-2026
# Optional: Meta app secret to validate webhook signatures
WHATSAPP_APP_SECRET=

# ── AI providers (fill at least one) ────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
